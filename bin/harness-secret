#!/usr/bin/env bash
# harness-secret: store and fetch the tokens the MCP wrappers need, without
# ever putting them in a repo, a YAML file, or Omnigent's database.
#
#   harness-secret set NAME      read a value from the terminal (hidden) and store it
#   harness-secret get NAME      print the value to stdout
#   harness-secret delete NAME   remove it
#   harness-secret backend       print which backend is in use
#
# Lookup order for `get`:
#   1. <NAME>_COMMAND from ~/.config/harness/harness.env (run via sh -c;
#      its stdout is the secret), e.g. "op read op://Vault/Item/credential"
#   2. the backend: HARNESS_SECRET_BACKEND if set, else macOS Keychain on
#      macOS, secret-tool (libsecret) on Linux if installed, else files in
#      ~/.config/harness/secrets/ (dir 0700, files 0600).
set -euo pipefail

SERVICE="harness"
CONFIG_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/harness"
ENV_FILE="${HARNESS_ENV_FILE:-$CONFIG_DIR/harness.env}"
SECRETS_DIR="$CONFIG_DIR/secrets"

die() { printf 'harness-secret: %s\n' "$*" >&2; exit 1; }

if [ -f "$ENV_FILE" ]; then
  set -a
  # shellcheck disable=SC1090
  . "$ENV_FILE"
  set +a
fi

# MCP servers are started with a minimal environment that drops the D-Bus
# address secret-tool needs. Fall back to the standard per-user bus socket.
user_bus="/run/user/$(id -u)/bus"
if [ -z "${DBUS_SESSION_BUS_ADDRESS:-}" ] && [ -S "$user_bus" ]; then
  export DBUS_SESSION_BUS_ADDRESS="unix:path=$user_bus"
fi

backend() {
  if [ -n "${HARNESS_SECRET_BACKEND:-}" ]; then
    printf '%s\n' "$HARNESS_SECRET_BACKEND"
  elif [ "$(uname -s)" = "Darwin" ] && command -v security >/dev/null 2>&1; then
    echo keychain
  elif command -v secret-tool >/dev/null 2>&1; then
    echo secret-tool
  else
    echo file
  fi
}

check_name() {
  case "$1" in
    ''|*[!A-Za-z0-9_]*) die "secret names may contain only letters, digits and _: '$1'" ;;
  esac
}

cmd_get() {
  local name="$1" cmd_var="${1}_COMMAND" value
  if [ -n "${!cmd_var:-}" ]; then
    value="$(sh -c "${!cmd_var}" </dev/null)" || die "$cmd_var failed"
    [ -n "$value" ] || die "$cmd_var printed nothing"
    printf '%s\n' "$value"
    return
  fi
  case "$(backend)" in
    keychain)
      security find-generic-password -s "$SERVICE" -a "$name" -w 2>/dev/null \
        || die "$name not found in Keychain. Run: harness-secret set $name" ;;
    secret-tool)
      value="$(secret-tool lookup service "$SERVICE" account "$name" 2>/dev/null)" || true
      [ -n "$value" ] || die "$name not found via secret-tool. Run: harness-secret set $name"
      printf '%s\n' "$value" ;;
    file)
      [ -f "$SECRETS_DIR/$name" ] || die "$name not found in $SECRETS_DIR. Run: harness-secret set $name"
      cat "$SECRETS_DIR/$name" ;;
    *) die "unknown HARNESS_SECRET_BACKEND '$(backend)' (use keychain, secret-tool or file)" ;;
  esac
}

cmd_set() {
  local name="$1" value
  if [ -t 0 ]; then
    printf 'Value for %s (input hidden): ' "$name" >&2
    IFS= read -rs value
    printf '\n' >&2
  else
    IFS= read -r value || true
  fi
  [ -n "$value" ] || die "empty value; nothing stored"
  case "$(backend)" in
    keychain)
      # -U updates an existing item. The value is passed as an argument, which
      # is briefly visible to other processes of this user; macOS offers no
      # stdin option for add-generic-password.
      security add-generic-password -U -s "$SERVICE" -a "$name" -l "$SERVICE: $name" -w "$value" ;;
    secret-tool)
      printf '%s' "$value" | secret-tool store --label="$SERVICE: $name" service "$SERVICE" account "$name" ;;
    file)
      ( umask 077; mkdir -p "$SECRETS_DIR"; printf '%s\n' "$value" > "$SECRETS_DIR/$name" )
      chmod 700 "$SECRETS_DIR"; chmod 600 "$SECRETS_DIR/$name" ;;
    *) die "unknown HARNESS_SECRET_BACKEND '$(backend)'" ;;
  esac
  printf 'Stored %s (backend: %s)\n' "$name" "$(backend)" >&2
}

cmd_delete() {
  local name="$1"
  case "$(backend)" in
    keychain)    security delete-generic-password -s "$SERVICE" -a "$name" >/dev/null ;;
    secret-tool) secret-tool clear service "$SERVICE" account "$name" ;;
    file)        rm -f "$SECRETS_DIR/$name" ;;
    *) die "unknown HARNESS_SECRET_BACKEND '$(backend)'" ;;
  esac
  printf 'Deleted %s\n' "$name" >&2
}

usage() { sed -n '2,16p' "$0" | sed 's/^# \{0,1\}//' >&2; exit 2; }

[ $# -ge 1 ] || usage
case "$1" in
  get|set|delete)
    [ $# -eq 2 ] || usage
    check_name "$2"
    "cmd_$1" "$2" ;;
  backend) backend ;;
  -h|--help|help) usage ;;
  *) usage ;;
esac
