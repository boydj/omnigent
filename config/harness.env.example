# Harness settings: NON-SECRET values only.
#
# bootstrap.sh copies this file to ~/.config/harness/harness.env (once; it
# never overwrites your copy). Edit that copy per machine: home and work
# differ in Jira site, email, and how strict you want the tools to be.
# Secrets (tokens) never go here. Store them with:
#   harness-secret set GITHUB_PERSONAL_ACCESS_TOKEN
#   harness-secret set JIRA_API_TOKEN
#
# The MCP wrappers (bin/mcp-github, bin/mcp-jira) source this file each time
# Omnigent starts a server, so edits apply to the next session.

# --- Jira Cloud ------------------------------------------------------------
# Your site URL and the Atlassian account email the API token belongs to.
JIRA_URL=https://your-site.atlassian.net
JIRA_USERNAME=you@example.com

# Optional: limit every search/operation to these project keys (comma list).
JIRA_PROJECTS_FILTER=

# Tool groups to expose. "default" = issues, fields, comments, transitions.
# jira_agile adds boards and sprints; the others add projects, links, users.
# Fewer tools = less context used and better tool choice by the model.
JIRA_TOOLSETS=default,jira_agile,jira_projects,jira_links,jira_users

# true = only read tools are exposed (no create/update/transition/comment).
JIRA_READ_ONLY=false

# --- GitHub ----------------------------------------------------------------
# Tool groups to expose. "context" is strongly recommended by GitHub.
GITHUB_TOOLSETS=context,repos,issues,pull_requests,actions,users

# 1 = only read tools are exposed.
GITHUB_READ_ONLY=0

# Tools removed even when their toolset is on. Merging, deleting files and
# creating/forking repos stay with you during the evaluation. Empty = none.
GITHUB_EXCLUDE_TOOLS=merge_pull_request,delete_file,create_repository,fork_repository

# 1 = hide issue/PR/comment content from authors without push access on
# public repos (a prompt-injection mitigation, not an authorization boundary).
GITHUB_LOCKDOWN_MODE=1

# Only for GitHub Enterprise Server / ghe.com, e.g. https://github.example.com
# GITHUB_HOST=

# --- Network (work machines) ------------------------------------------------
# Omnigent starts MCP servers with a minimal environment: your shell's proxy
# and CA settings do NOT reach them. Set them here instead (this file is
# loaded by the wrappers). Both servers also trust the OS certificate store.
# HTTPS_PROXY=http://proxy.example.com:8080
# NO_PROXY=localhost,127.0.0.1,.example.com
# SSL_CERT_FILE=/path/to/corporate-ca-bundle.pem        # github-mcp-server (Go)
# REQUESTS_CA_BUNDLE=/path/to/corporate-ca-bundle.pem   # mcp-atlassian (Python)

# --- Secret source overrides (optional) ------------------------------------
# By default secrets come from the OS keychain (macOS Keychain, or libsecret
# via secret-tool on Linux), falling back to owner-only files under
# ~/.config/harness/secrets/. To use another source instead, set
# <NAME>_COMMAND to a command whose stdout is the secret. Examples:
#
# GITHUB_PERSONAL_ACCESS_TOKEN_COMMAND="gh auth token"
# GITHUB_PERSONAL_ACCESS_TOKEN_COMMAND="op read op://Work/GitHub MCP PAT/credential"
# JIRA_API_TOKEN_COMMAND="op read op://Work/Jira API token/credential"
#
# Force one backend for all secrets: keychain | secret-tool | file
# HARNESS_SECRET_BACKEND=file
